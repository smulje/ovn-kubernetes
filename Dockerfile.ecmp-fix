# ECMP route fix build (OCPBUGS-70272)
# Based on dist/images/Dockerfile.fedora but using cluster base image

# Stage 1: Build ovnkube from source
FROM quay.io/fedora/fedora:42 AS builder

USER root

ENV PYTHONDONTWRITEBYTECODE yes

# Install build dependencies
RUN dnf install --best --refresh -y --setopt=tsflags=nodocs \
    git \
    golang \
    make \
    gcc \
    && dnf clean all && rm -rf /var/cache/dnf/*

WORKDIR /root/ovn-kubernetes
COPY . .

# Build ovnkube and other binaries
RUN cd go-controller && CGO_ENABLED=1 make

# Stage 2: Use cluster base image
FROM quay.io/openshift-release-dev/ocp-v4.0-art-dev@sha256:53ecbed423371b09c2867ebbc1ad10dbc259eb69a1dadb0162a491548a503d8a

USER root

# Copy ALL built binaries (not just ovnkube)
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovnkube /usr/bin/ovnkube
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovnkube-identity /usr/bin/ovnkube-identity
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovn-kube-util /usr/bin/ovn-kube-util
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovn-k8s-cni-overlay /usr/libexec/cni/ovn-k8s-cni-overlay
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovndbchecker /usr/bin/ovndbchecker
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovnkube-trace /usr/bin/ovnkube-trace
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/hybrid-overlay-node /usr/bin/hybrid-overlay-node
COPY --from=builder /root/ovn-kubernetes/go-controller/_output/go/bin/ovnkube-observ /usr/bin/ovnkube-observ

RUN chmod +x /usr/bin/ovnkube /usr/bin/ovnkube-identity /usr/bin/ovn-kube-util \
    /usr/libexec/cni/ovn-k8s-cni-overlay /usr/bin/ovndbchecker /usr/bin/ovnkube-trace \
    /usr/bin/hybrid-overlay-node /usr/bin/ovnkube-observ

USER 1001
